@model GestaoAgenda.Models.Agendamento
@using GestaoAgenda.ViewModels
@{ ViewData["Title"] = "Detalhes do agendamento"; }
<h2 class="fw-bold mb-4">Detalhes do agendamento</h2>
<div class="bg-caixa p-3 p-md-4 text-break">
    <p><strong>Cliente:</strong> @Model.Cliente.Nome</p>
    <p><strong>Serviço:</strong> @Model.Servico.Nome</p>
    <p><strong>Profissional:</strong> @(Model.ProfissionalServico?.Profissional.Nome ?? "Não informado")</p>
    <p><strong>Data:</strong> @Model.Data.ToString("dd/MM/yyyy")</p>
    <p><strong>Hora:</strong> @Model.Hora.ToString("hh':'mm")</p>
    <p><strong>Término:</strong> @(Model.Termino?.ToString("dd/MM/yyyy HH:mm") ?? "Não informado")</p>
    <p><strong>Preço aplicado:</strong> @(Model.PrecoAplicado is decimal preco ? $"R$ {PrecoPtBr.Formatar(preco)}" : "Não informado")</p>
    <p><strong>Duração aplicada:</strong> @(Model.DuracaoMinutosAplicada is int minutos ? $"{minutos} min" : "Não informada")</p>
    <p><strong>Status:</strong> @Model.Status</p>
    <p><strong>Observação:</strong> @Model.Observacao</p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>