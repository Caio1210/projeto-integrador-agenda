@model GestaoAgenda.Models.Agendamento
@{ ViewData["Title"] = "Excluir agendamento"; }<h2 class="fw-bold mb-4">Excluir agendamento</h2><div class="bg-caixa p-4"><p>Deseja excluir o agendamento de <strong>@Model.Cliente.Nome</strong> em <strong>@Model.Data.ToString("dd/MM/yyyy") às @Model.Hora.ToString(@"hh\:mm")</strong>?</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="btn btn-danger">Excluir</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></form></div>
