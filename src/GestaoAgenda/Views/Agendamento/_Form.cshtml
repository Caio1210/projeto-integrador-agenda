@model GestaoAgenda.Models.Agendamento
<div class="mb-3"><label asp-for="ClienteId" class="form-label"></label><select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId"><option value="">Selecione o cliente</option></select><span asp-validation-for="ClienteId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ServicoId" class="form-label"></label><select asp-for="ServicoId" class="form-select" asp-items="ViewBag.ServicoId"><option value="">Selecione o serviço</option></select><span asp-validation-for="ServicoId" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Data" class="form-label"></label><input asp-for="Data" class="form-control" type="date"/><span asp-validation-for="Data" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Hora" class="form-label"></label><input asp-for="Hora" class="form-control" type="time"/><span asp-validation-for="Hora" class="text-danger"></span></div></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Agendado</option><option>Concluído</option><option>Cancelado</option></select><span asp-validation-for="Status" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Observacao" class="form-label"></label><textarea asp-for="Observacao" class="form-control"></textarea></div>
