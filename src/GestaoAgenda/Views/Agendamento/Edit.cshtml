@model GestaoAgenda.ViewModels.AgendamentoFormViewModel

@{
    ViewData["Title"] = "Editar agendamento";
}

<h2 class="fw-bold mb-4">Editar agendamento</h2>

<div class="bg-caixa p-4">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <partial name="_Form" model="Model" />

        <button class="btn btn-primary" type="submit" disabled="@(!Model.PodeSalvar)" data-salvar-agendamento>Salvar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_AgendamentoValidationScripts" />
}
