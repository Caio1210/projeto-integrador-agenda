@using GestaoAgenda.Models
@{ ViewData["Title"] = "Dashboard - Agenda Beauty"; var hoje = (List<Agendamento>)ViewBag.AgendamentosHoje; var proximos = (List<Agendamento>)ViewBag.Proximos; }
<div class="container py-4">
<div class="row mb-4"><div class="col"><h2 class="fw-bold mb-0">Visão Geral</h2><p class="text-muted">Painel de agendamentos do salão.</p></div></div>
<div class="row g-4">
<div class="col-md-6 col-lg-4"><a asp-controller="Agendamento" asp-action="Index" class="text-decoration-none"><div class="card card-dashboard h-100 p-4"><div class="icon-circle"><i class="bi bi-calendar-check"></i></div><h3 class="stat-number">@ViewBag.TotalAgendamentos</h3><span class="stat-label">Agendamentos</span></div></a></div>
<div class="col-md-6 col-lg-4"><a asp-controller="Cliente" asp-action="Index" class="text-decoration-none"><div class="card card-dashboard h-100 p-4"><div class="icon-circle"><i class="bi bi-people"></i></div><h3 class="stat-number">@ViewBag.TotalClientes</h3><span class="stat-label">Clientes</span></div></a></div>
<div class="col-md-6 col-lg-4"><a asp-controller="Servico" asp-action="Index" class="text-decoration-none"><div class="card card-dashboard h-100 p-4"><div class="icon-circle"><i class="bi bi-scissors"></i></div><h3 class="stat-number">@ViewBag.TotalServicos</h3><span class="stat-label">Serviços</span></div></a></div>
</div>
<div class="bg-caixa p-4 mt-5"><div class="d-flex justify-content-between align-items-center"><h3 class="fw-bold">Agenda de hoje</h3><a asp-controller="Agendamento" asp-action="Create" class="btn btn-primary">Novo agendamento</a></div><hr/>
@if (!hoje.Any()) { <p class="text-muted">Nenhum agendamento para hoje.</p> } else { <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Horário</th><th>Cliente</th><th>Serviço</th><th>Status</th></tr></thead><tbody>@foreach(var a in hoje){<tr><td>@a.Hora.ToString(@"hh\:mm")</td><td>@a.Cliente.Nome</td><td>@a.Servico.Nome</td><td>@a.Status</td></tr>}</tbody></table></div>}
</div>
<div class="bg-caixa p-4 mt-4"><h3 class="fw-bold">Próximos agendamentos</h3><hr/>@if(!proximos.Any()){<p class="text-muted">Nenhum agendamento futuro.</p>}else{<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Data</th><th>Hora</th><th>Cliente</th><th>Serviço</th></tr></thead><tbody>@foreach(var a in proximos){<tr><td>@a.Data.ToString("dd/MM/yyyy")</td><td>@a.Hora.ToString(@"hh\:mm")</td><td>@a.Cliente.Nome</td><td>@a.Servico.Nome</td></tr>}</tbody></table></div>}</div>
</div>
