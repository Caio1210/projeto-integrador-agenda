@model IEnumerable<GestaoAgenda.Models.Servico>
@{ ViewData["Title"] = "Serviços"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2 class="fw-bold">Serviços</h2><a asp-action="Create" class="btn btn-primary">Novo serviço</a></div>
@if(TempData["Erro"] != null){<div class="alert alert-warning">@TempData["Erro"]</div>}
<div class="table-responsive bg-caixa p-4"><table class="table table-striped"><thead><tr><th>Nome</th><th>Descrição</th><th>Duração</th><th>Valor</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Nome</td><td>@item.Descricao</td><td>@item.Duracao min</td><td>@item.Valor.ToString("C")</td><td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalhes</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a></td></tr>}</tbody></table></div>
