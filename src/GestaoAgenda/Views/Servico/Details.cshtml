@model GestaoAgenda.Models.Servico
@{ ViewData["Title"] = "Detalhes do serviço"; }<h2 class="fw-bold mb-4">Detalhes do serviço</h2><div class="bg-caixa p-4"><p><strong>Nome:</strong> @Model.Nome</p><p><strong>Descrição:</strong> @Model.Descricao</p><p><strong>Duração:</strong> @Model.Duracao minutos</p><p><strong>Valor:</strong> @Model.Valor.ToString("C")</p><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a> <a asp-action="Index" class="btn btn-secondary">Voltar</a></div>
