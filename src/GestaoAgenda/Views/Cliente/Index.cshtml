@model IEnumerable<GestaoAgenda.Models.Cliente>
@{ ViewData["Title"] = "Clientes"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2 class="fw-bold">Clientes</h2><a asp-action="Create" class="btn btn-primary">Novo cliente</a></div>
@if(TempData["Erro"] != null){<div class="alert alert-warning">@TempData["Erro"]</div>}
<div class="table-responsive bg-caixa p-4"><table class="table table-striped"><thead><tr><th>Nome</th><th>Telefone</th><th>E-mail</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Nome</td><td>@item.Telefone</td><td>@item.Email</td><td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalhes</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a></td></tr>}</tbody></table></div>
