@model GestaoAgenda.Models.Cliente
@{ ViewData["Title"] = "Excluir cliente"; }
<h2 class="fw-bold mb-4">Excluir cliente</h2><div class="bg-caixa p-4"><p>Deseja excluir <strong>@Model.Nome</strong>?</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="btn btn-danger" type="submit">Excluir</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></form></div>
