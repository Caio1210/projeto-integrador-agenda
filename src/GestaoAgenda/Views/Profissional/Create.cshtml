@model GestaoAgenda.ViewModels.ProfissionalFormViewModel
@{ ViewData["Title"] = "Novo profissional"; }
<h2 class="fw-bold mb-4">Novo profissional</h2>
<div class="bg-caixa p-3 p-md-4">
    <form asp-action="Create" method="post" data-profissional-form>
        <partial name="_Form" model="Model" />
        @if (!Model.PodeSalvar)
        {
            <p class="alert alert-warning" role="alert">O envio está indisponível. Recarregue o formulário para tentar novamente.</p>
            <a asp-action="@ViewContext.RouteData.Values["action"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id)" class="btn btn-outline-primary mb-3">Recarregar formulário</a>
        }
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary" disabled="@(!Model.PodeSalvar)" data-salvar>Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ProfissionalValidationScripts" />
}