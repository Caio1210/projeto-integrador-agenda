@model GestaoAgenda.Models.Profissional
@{ ViewData["Title"] = "Detalhes do profissional"; }
<h2 class="fw-bold mb-4">Detalhes do profissional</h2>
<div class="bg-caixa p-3 p-md-4 text-break">
    <dl class="row">
        <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Nome</dd>
        <dt class="col-sm-3">Telefone</dt><dd class="col-sm-9">@Model.Telefone</dd>
        <dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Email) ? "Não informado" : Model.Email)</dd>
        <dt class="col-sm-3">Especialidade</dt><dd class="col-sm-9">@Model.Especialidade</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.Ativo ? "Ativo" : "Inativo")</dd>
    </dl>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>