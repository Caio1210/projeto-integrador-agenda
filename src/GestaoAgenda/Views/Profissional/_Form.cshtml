@model GestaoAgenda.ViewModels.ProfissionalFormViewModel
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row">
    <div class="col-12 col-md-6 mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" autocomplete="name" maxlength="120" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <label asp-for="Especialidade" class="form-label"></label>
        <input asp-for="Especialidade" class="form-control" maxlength="120" />
        <span asp-validation-for="Especialidade" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <label asp-for="Telefone" class="form-label"></label>
        <input asp-for="Telefone" class="form-control" type="tel" autocomplete="tel" maxlength="20" />
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="email" maxlength="120" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
</div>
<div class="form-check mb-3">
    <input asp-for="Ativo" class="form-check-input" />
    <label asp-for="Ativo" class="form-check-label"></label>
</div>
<input type="hidden" asp-for="TokenEnvio" />
<partial name="_ServicosOferecidos" model="Model" />